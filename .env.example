# Variables d'environnement Kenza — copier en `.env.local` pour le développement.
#
# `.env*` est git-ignoré (voir .gitignore) : ce fichier est le seul à être versionné,
# il ne doit donc JAMAIS contenir de valeur réelle. Les valeurs ci-dessous sont des
# placeholders qui indiquent le format attendu.
#
# En production (Vercel), ces variables sont définies dans Project Settings > Environment
# Variables. Voir DEPLOIEMENT.md pour la procédure complète.

# --- Supabase (obligatoire) ---------------------------------------------------
# Project Settings > API. L'URL ressemble à https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique « anon » : exposée au navigateur, protégée par les policies RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clé service_role (côté serveur uniquement) : contourne les RLS.
# À ne JAMAIS exposer au navigateur (pas de préfixe NEXT_PUBLIC_) ni committer.
# Requise par le webhook Stripe pour accorder et révoquer le statut premium.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Stripe Monétisation (obligatoire pour les paiements) ---------------------
# Séparation stricte Production (Live) vs Preview / Local (Test) :
#
# En Production (Vercel Production Environment) :
#   - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
#   - STRIPE_SECRET_KEY=sk_live_...
#   - STRIPE_WEBHOOK_SECRET=whsec_... (Généré depuis l'endpoint Webhook Live sur /api/stripe/webhook)
#
# En Preview & Local (.env.local) :
#   - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#   - STRIPE_SECRET_KEY=sk_test_...
#   - STRIPE_WEBHOOK_SECRET=whsec_... (Généré par stripe listen ou webhook de test)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Identifiants de prix Stripe (Optionnels - repli automatique dynamique si non fournis) :
# Si vous créez les produits/prix directement dans votre Dashboard Stripe, vous pouvez
# renseigner ces IDs. Sinon, Kenza génère automatiquement les sessions avec les tarifs
# officiels (59 € / 9 € et 590 MAD / 90 MAD).
# STRIPE_PRICE_ANNUAL_EUR=price_...
# STRIPE_PRICE_MONTHLY_EUR=price_...
# STRIPE_PRICE_ANNUAL_MAD=price_...
# STRIPE_PRICE_MONTHLY_MAD=price_...

# --- Groq AI (obligatoire pour le roleplay IA et KenzBot) ---------------------
# Clé API Groq Cloud (console.groq.com).
# Sans elle, /api/roleplay/chat renvoie HTTP 503 explicite.
GROQ_API_KEY=gsk_...
# Modèle Groq officiel pour le roleplay (défaut: llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Application (recommandé) -------------------------------------------------
# Origine de production utilisée par l'allowlist de redirection Stripe
# (src/lib/allowedOrigins.ts). Les URL de succès/annulation sont reconstruites
# à partir de cette valeur, jamais depuis un header client non vérifié.
NEXT_PUBLIC_APP_URL=https://kenza-dusky.vercel.app

# --- Développement local (optionnel) ------------------------------------------
# Non requis : l'application fonctionne sans. Ne pas définir en production.
# Les anciens flags de déverrouillage ont été supprimés du store : le premium
# ne peut venir que de profiles.is_premium (écrit par le webhook Stripe).
