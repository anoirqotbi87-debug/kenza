# See https://help.github.com/articles/ignoring-files/ for more information about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
build.log

# generated service worker (généré par Serwist depuis src/app/sw.ts)
public/sw.js
public/sw.js.map

# artefacts du patcher UI (supprimé) — ne pas re-committer
docs/verify.json

# env files (can opt-in for committing if needed)
.env*
# ...sauf le modele, qui documente le format attendu et ne contient aucun secret.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenHands agent memory (local, not for VCS)
/.openhands/

# Android / TWA — artefacts de build et CLE DE SIGNATURE.
# Le keystore n'est pas recuperable : le commiter permettrait a n'importe qui de
# signer des APK au nom de l'app, et Play refuse la rotation d'une cle d'upload.
*.keystore
*.jks
*.aab
*.apk
!public/downloads/*.apk
twa/

# local test / audit scripts
/scripts/

# parasite directories (ex: Dify workflow artefacts)
/{*
